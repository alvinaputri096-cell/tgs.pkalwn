#include <iostream>
using namespace std;

int main() {
    int nilai;
    char ulang;

    do {
        cout << "===== PROGRAM NILAI SISWA =====" << endl;
        cout << "Masukkan nilai: ";
        cin >> nilai;

        if (nilai < 0 || nilai > 100) {
            cout << "Nilai tidak valid!" << endl;
        } else if (nilai > 90) {
            cout << "Grade A" << endl;
        } else if (nilai > 80) {
            cout << "Grade B" << endl;
        } else if (nilai > 70) {
            cout << "Grade C" << endl;
        } else {
            cout << "Grade D" << endl;
        }

        cout << "Mau mengulang? (y/t): ";
        cin >> ulang;

    } while (ulang == 'y' || ulang == 'Y');

    return 0;
}
